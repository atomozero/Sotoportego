name			sotoportego
version			0.2.3-1
architecture	@ARCH@
summary			"Native VPN client for Haiku"
description		"Native Haiku VPN client: a privilege-separated background \
daemon owns the VPN lifecycle, with a Haiku-native GUI front-end and a CLI \
test client driving it over BMessage. OpenVPN is wired in end to end (.ovpn \
import, live management-interface session, tun/N set-up, routing fix-up), and \
a from-scratch in-process WireGuard backend (Noise IKpsk2 handshake, \
ChaCha20-Poly1305 transport, rekey, anti-replay, AllowedIPs routing) and a \
from-scratch in-process Tailscale backend (ts2021 control plane, network map, \
DERP relay with reconnect, disco NAT traversal, MagicDNS, WireGuard rekey, \
subnet routes, exit nodes, and a live tailnet map) ship alongside. A VPNGate \
map browser plots the public catalogue on a pan/zoom world map."
packager		"atomozero <atomozero@proton.me>"
vendor			"atomozero"
copyrights		"2026 atomozero"
licenses		"MIT"

provides {
	sotoportego = 0.2.3
}

requires {
	haiku >= r1~beta5
	cmd:openvpn
	lib:libcrypto >= 3
}
